{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D200 Deck",
  "version": "0.2.0",
  "identifier": "dev.d200deck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Teclas dinâmicas para o Ulanzi D200",
    "resources": {
      "../../extension-edge/manifest.json": "extension-edge/manifest.json",
      "../../extension-edge/background.js": "extension-edge/background.js"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RDcxQkM3ODk3MEMwMUQKUldRZHdIQ0p4eHZYaFRiNCtVLzhJUUthYnB6RmJjeTFxMkVxU3hnVWZkcktFUlp6WFJMdExMS2cK",
      "endpoints": ["https://github.com/argus-cs/d200-deck/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
